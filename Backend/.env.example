PORT=6050
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/collab-code-editor
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=7d
FRONTEND_URL=https://your-frontend-domain.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback

# Code Execution Settings
ENABLE_CODE_EXECUTION=true
EXECUTION_PROVIDER=judge0 # 'judge0' or 'docker'

# Judge0 Settings (Cloud CE, RapidAPI, or Self-Hosted)
JUDGE0_API_URL=https://ce.judge0.com # Or your self-hosted URL: http://<vps-ip>:2358
JUDGE0_API_KEY= # Optional API key / auth token if required
JUDGE0_API_HOST= # Optional (e.g. judge0-ce.p.rapidapi.com for RapidAPI)
JUDGE0_AUTH_TOKEN= # Optional if your self-hosted Judge0 requires AUTH_TOKEN
JUDGE0_CPU_TIME_LIMIT=10
JUDGE0_MEMORY_LIMIT=128000

# Docker Runner Settings (Used only if EXECUTION_PROVIDER=docker or ENABLE_DOCKER_FALLBACK=true)
CODE_EXECUTION_TMP_DIR=/opt/collaborative-code-editor/Backend/temp
ENABLE_DOCKER_FALLBACK=false
